generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  user
  platform_super_admin
}

enum DealerStatus {
  active
  suspended
  inactive
}

enum DealerSetupStatus {
  pending_setup
  ready_for_dns
  active
  suspended
}

enum DealerMembershipRole {
  dealer_owner
  dealer_admin
  staff
}

enum DealerSubscriptionStatus {
  active
  trialing
  past_due
  suspended
  canceled
}

enum DealerDomainStatus {
  pending_dns
  active
  failed
  disabled
}

// ─── Dealer / SaaS Models ──────────────────────────────────────

model Dealer {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  status               DealerStatus          @default(active)
  setupStatus          DealerSetupStatus     @default(pending_setup)
  isDefault            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  settings             DealerSettings?
  domains              DealerDomain[]
  memberships          DealerMembership[]
  subscriptions        DealerSubscription[]
  counters             Counter[]
  suppliers            Supplier[]
  vehicles             Vehicle[]
  vehicleCosts         VehicleCost[]
  vehicleImages        VehicleImage[]
  vehicleDocuments     VehicleDocument[]
  vehicleProtocols     VehicleHandoverProtocol[]
  customers            Customer[]
  customerDocuments    CustomerDocument[]
  sales                Sale[]
  workLogItems         WorkLogItem[]
  customBrands         CustomBrand[]
  customColors         CustomColor[]
  customSuppliers      CustomSupplier[]
  customConnectorTypes CustomConnectorType[]
}

model DealerSettings {
  id                    String   @id @default(cuid())
  dealerId              String   @unique
  dealer                Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  displayName           String?
  legalName             String?
  addressLine1          String?
  zip                   String?
  city                  String?
  country               String?
  phone                 String?
  email                 String?
  supportEmail          String?
  website               String?
  taxId                 String?
  legalRepresentative   String?
  bankName              String?
  iban                  String?
  bic                   String?
  logoUrl               String?
  faviconUrl            String?
  primaryColor          String?
  accentColor           String?
  loginHeadline         String?
  documentFooterText    String?
  documentLegalText     String?
  purchaseTerms         String?
  saleTerms             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DealerDomain {
  id                String             @id @default(cuid())
  dealerId          String
  dealer            Dealer             @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  host              String             @unique
  status            DealerDomainStatus @default(pending_dns)
  isPrimary         Boolean            @default(false)
  verificationToken String?
  verifiedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([dealerId, status])
}

model Plan {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  description         String?
  monthlyPriceCents   Int                  @default(0)
  stripePriceMonthlyId String?
  featureEntitlements Json
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  subscriptions       DealerSubscription[]
}

model DealerSubscription {
  id               String                   @id @default(cuid())
  dealerId         String
  dealer           Dealer                   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan                     @relation(fields: [planId], references: [id], onDelete: Restrict)
  status           DealerSubscriptionStatus @default(active)
  stripeCustomerId String?
  stripeSubscriptionId String?
  stripeCheckoutSessionId String?
  stripePriceId    String?
  complimentaryAccess Boolean              @default(false)
  featureOverrides Json?
  billingNotes     String?
  trialEndsAt      DateTime?
  currentPeriodEndsAt DateTime?
  startsAt         DateTime                 @default(now())
  endsAt           DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([dealerId, status])
  @@unique([stripeSubscriptionId])
  @@unique([dealerId, planId])
}

model DealerMembership {
  id        String               @id @default(cuid())
  dealerId  String
  dealer    Dealer               @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      DealerMembershipRole @default(staff)
  isDefault Boolean              @default(false)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([dealerId, userId])
  @@index([userId, isDefault])
}

// ─── Auth Models ───────────────────────────────────────────────

model User {
  id              String             @id
  name            String
  email           String             @unique
  emailVerified   Boolean            @default(false)
  image           String?
  username        String?            @unique
  displayUsername String?
  platformRole    PlatformRole       @default(user)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  sessions        Session[]
  accounts        Account[]
  memberships     DealerMembership[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model OnboardingInquiry {
  id           String   @id @default(cuid())
  businessName String
  contactName  String
  email        String
  phone        String?
  website      String?
  notes        String?
  status       String   @default("new")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Counter for sequential vehicle numbers ────────────────────

model Counter {
  id       String   @id @default(cuid())
  dealerId String
  dealer   Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  key      String
  value    Int      @default(0)

  @@unique([dealerId, key])
}

model Supplier {
  id            String    @id @default(cuid())
  dealerId      String
  dealer        Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name          String
  supplierType  String    @default("gewerblich")
  address       String?
  street        String?
  zip           String?
  city          String?
  country       String?
  contactPerson String?
  phone         String?
  phone2        String?
  email         String?
  website       String?
  iban          String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  vehicles      Vehicle[]

  @@index([dealerId, name])
}

model Vehicle {
  id                     String                  @id @default(cuid())
  dealerId               String
  dealer                 Dealer                  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  vehicleNumber          String
  brand                  String
  model                  String
  year                   Int?
  mileage                Int
  vin                    String?
  hsn                    String?
  tsn                    String?
  registrationDocNumber  String?
  color                  String?
  fuelType               String?
  transmission           String?
  power                  String?
  features               String?
  purchasePrice          Float
  sellingPrice           Float
  taxRate                Float                   @default(19.0)
  marginTaxed            Boolean                 @default(false)
  isPrivate              Boolean                 @default(false)
  status                 String                  @default("available")
  notes                  String?
  internalNotes          String?
  customerId             String?
  customer               Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId             String?
  supplierRel            Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  handoverProtocol       VehicleHandoverProtocol?
  images                 VehicleImage[]
  documents              VehicleDocument[]
  sales                  Sale[]
  costs                  VehicleCost[]
  workLog                WorkLogItem[]
  co2Emission            Float?
  displacement           Int?
  powerKw                Float?
  hasDamage              Boolean                 @default(false)
  damageDescription      String?
  damageAmount           Float?
  batteryCapacity        Float?
  electricRange          Int?
  batterySoh             Float?
  batteryType            String?
  exportEnabled          Boolean                 @default(false)
  transportCostDomestic  Float?
  transportCostAbroad    Float?
  customsDuties          Float?
  registrationFees       Float?
  repairCostsAbroad      Float?
  firstRegistration      DateTime?
  supplier               String?
  chargingTime           Int?
  connectorType          String?
  huDue                  DateTime?
  previousOwners         Int?
  serviceDueKm           Int?
  serviceDueDate         DateTime?
  bodyType               String?
  doors                  Int?
  seats                  Int?
  driveType              String?
  emissionClass          String?
  dealerPrice            Float?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([dealerId, vehicleNumber])
  @@index([dealerId, status])
}

model VehicleCost {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  costType  String
  amount    Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleImage {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  isPrimary Boolean  @default(false)
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model VehicleDocument {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name      String
  url       String
  fileName  String
  fileType  String?
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model VehicleHandoverProtocol {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  vehicleId String   @unique
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id                   String             @id @default(cuid())
  dealerId             String
  dealer               Dealer             @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  firstName            String
  lastName             String
  email                String?
  phone                String?
  phone2               String?
  address              String?
  city                 String?
  zip                  String?
  country              String?
  company              String?
  taxId                String?
  idDocumentType       String?
  idDocumentNumber     String?
  idDocumentValidUntil DateTime?
  notes                String?
  customerType         String             @default("privat")
  vehicles             Vehicle[]
  documents            CustomerDocument[]
  sales                Sale[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([dealerId, lastName])
}

model CustomerDocument {
  id         String   @id @default(cuid())
  dealerId   String
  dealer     Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name       String
  url        String
  fileName   String
  fileType   String?
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Sale {
  id         String   @id @default(cuid())
  dealerId   String
  dealer     Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salePrice  Float
  taxRate    Float    @default(19.0)
  saleDate   DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dealerId, saleDate])
}

model WorkLogItem {
  id          String   @id @default(cuid())
  dealerId    String
  dealer      Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  description String
  status      String   @default("open")
  assignee    String?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomBrand {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([dealerId, name])
}

model CustomColor {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([dealerId, name])
}

model CustomSupplier {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([dealerId, name])
}

model CustomConnectorType {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([dealerId, name])
}
