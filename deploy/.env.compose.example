# Compose runtime settings
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
APP_UID=1001
APP_GID=1001

# Optional container resource overrides
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.0
BACKEND_MEMORY_LIMIT=2g
BACKEND_CPU_LIMIT=2.0
WEB_MEMORY_LIMIT=256m
WEB_CPU_LIMIT=0.5

# Host bind mounts (persistent)
PG_DATA_PATH=./data/postgres
UPLOADS_PATH=./data/uploads
BACKUP_DIR=./backups
BACKUP_PREFIX=mainauto

# PostgreSQL container bootstrap
POSTGRES_DB=mainauto
POSTGRES_USER=mainauto
POSTGRES_PASSWORD=replace-me

# Backend runtime
DATABASE_URL=postgresql://mainauto:replace-me@postgres:5432/mainauto?schema=public
BETTER_AUTH_SECRET=replace-with-long-random-secret
BACKEND_URL=https://carops.de
PUBLIC_APP_URL=https://carops.de
PLATFORM_DOMAIN=carops.de
PLATFORM_SUPPORT_EMAIL=support@carops.de
CORS_ALLOWED_ORIGINS=https://carops.de
COOKIE_DOMAIN=
AUTH_DISABLE_CSRF_CHECK=false
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Initial admin bootstrap (set true only for first start)
BOOTSTRAP_ADMIN=false
INITIAL_ADMIN_USERNAME=mainauto
INITIAL_ADMIN_PASSWORD=replace-me
INITIAL_ADMIN_EMAIL=admin@carops.de

# Frontend build argument (empty = relative /api)
VITE_BACKEND_URL=
